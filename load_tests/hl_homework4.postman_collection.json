    {
      "name": "2. Add All Users as Friends",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Get registered users",
              "const users = JSON.parse(pm.collectionVariables.get(\"registered_users\") || \"[]\");",
              "",
              "if (users.length === 0) {",
              "    console.log(\"❌ No registered users found. Run registration first.\");",
              "    return;",
              "}",
              "",
              "console.log(`Adding friends for ${users.length} users...`);",
              "",
              "// For each user, add all other users as friends",
              "users.forEach((user, index) => {",
              "    console.log(`User ${index + 1}/${users.length}: ${user.username} adding friends...`);",
              "    ",
              "    users.forEach((otherUser) => {",
              "        if (user.profile_id !== otherUser.profile_id) {",
              "            // Add friend request using new endpoint /friend/add",
              "            const friendRequestBody = {",
              "                friend_id: otherUser.profile_id",
              "            };",
              "            ",
              "            pm.sendRequest({",
              "                url: \"http://localhost:8080/friend/add\",",
              "                method: \"POST\",",
              "                header: {",
              "                    \"Content-Type\": \"application/json\",",
              "                    \"Authorization\": `Bearer ${user.token}`",
              "                },",
              "                body: JSON.stringify(friendRequestBody)",
              "            }, function (err, res) {",
              "                if (!err && res.status === \"OK\") {",
              "                    console.log(`  ✅ Added friend: ${otherUser.username} (ID: ${otherUser.profile_id})`);",
              "                } else {",
              "                    console.log(`  ❌ Failed to add friend: ${otherUser.username}`);",
              "                }",
              "            });",
              "        }",
              "    });",
              "});",
              "",
              "setTimeout(() => {",
              "    console.log(\"✅ All friend requests processed!\");",
              "}, 2000);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"friend_id\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/stats",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "stats"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Create Posts from Source",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Get registered users",
              "const users = JSON.parse(pm.collectionVariables.get(\"registered_users\") || \"[]\");",
              "const N = parseInt(pm.collectionVariables.get(\"N_users\")) || 5;",
              "",
              "if (users.length === 0) {",
              "    console.log(\"❌ No registered users found. Run registration first.\");",
              "    return;",
              "}",
              "",
              "console.log(\"Fetching posts from source...\");",
              "",
              "// Fetch posts from GitHub",
              "pm.sendRequest({",
              "    url: \"https://raw.githubusercontent.com/OtusTeam/highload/refs/heads/master/homework/posts.txt\",",
              "    method: \"GET\"",
              "}, function (err, res) {",
              "    if (err) {",
              "        console.log(\"❌ Error fetching posts:\", err);",
              "        return;",
              "    }",
              "    ",
              "    const postsText = res.text();",
              "    ",
              "    // Split text into sentences or paragraphs",
              "    const sentences = postsText.split(/[.!?]+/).filter(s => s.trim().length > 10);",
              "    console.log(`Found ${sentences.length} sentences in source`);",
              "    ",
              "    // Счетчики для отслеживания прогресса",
              "    let totalPosts = users.length * N;",
              "    let completedPosts = 0;",
              "    let failedPosts = 0;",
              "    ",
              "    // For each user, create N posts",
              "    users.forEach((user, userIndex) => {",
              "        console.log(`User ${userIndex + 1}/${users.length}: ${user.username} creating ${N} posts...`);",
              "        ",
              "        for (let i = 0; i < N; i++) {",
              "            // Создаем замыкание для сохранения значений",
              "            (function(postIndex, username, token) {",
              "                // Select random sentences for this post",
              "                const numSentences = Math.floor(Math.random() * 3) + 2; // 2-4 sentences per post",
              "                let postContent = \"\";",
              "                ",
              "                for (let j = 0; j < numSentences; j++) {",
              "                    const randomIndex = Math.floor(Math.random() * sentences.length);",
              "                    postContent += sentences[randomIndex].trim() + \". \";",
              "                }",
              "                ",
              "                // Trim and limit content length",
              "                postContent = postContent.trim();",
              "                if (postContent.length > 1000) {",
              "                    postContent = postContent.substring(0, 997) + \"...\";",
              "                }",
              "                ",
              "                const postRequestBody = {",
              "                    content: postContent",
              "                };",
              "                ",
              "                pm.sendRequest({",
              "                    url: \"http://localhost:8080/post/create\",",
              "                    method: \"POST\",",
              "                    header: {",
              "                        \"Content-Type\": \"application/json\",",
              "                        \"Authorization\": \"Bearer \" + token",
              "                    },",
              "                    body: {",
              "                        mode: \"raw\",",
              "                        raw: JSON.stringify(postRequestBody)",
              "                    }",
              "                }, function (err2, res2) {",
              "                    completedPosts++;",
              "                    ",
              "                    if (!err2 && res2.code >= 200 && res2.code < 300) {",
              "                        console.log(`  ✅ Post ${postIndex+1}/${N} created for ${username}`);",
              "                    } else {",
              "                        failedPosts++;",
              "                        const statusCode = res2 ? res2.code : 'no response';",
              "                        console.log(`  ❌ Failed to create post ${postIndex+1} for ${username} (status: ${statusCode})`);",
              "                        ",
              "                        // Выводим дополнительную информацию об ошибке",
              "                        if (res2 && res2.text()) {",
              "                            try {",
              "                                const errorBody = res2.json();",
              "                                console.log(`     Error details: ${JSON.stringify(errorBody)}`);",
              "                            } catch (e) {",
              "                                console.log(`     Response: ${res2.text().substring(0, 200)}`);",
              "                            }",
              "                        }",
              "                    }",
              "                    ",
              "                    // Когда все посты обработаны",
              "                    if (completedPosts === totalPosts) {",
              "                        const successPosts = totalPosts - failedPosts;",
              "                        console.log(\"\\n=== POST CREATION SUMMARY ===\");",
              "                        console.log(`✅ Successfully created: ${successPosts}/${totalPosts} posts`);",
              "                        if (failedPosts > 0) {",
              "                            console.log(`❌ Failed: ${failedPosts} posts`);",
              "                        }",
              "                        console.log(\"==============================\\n\");",
              "                    }",
              "                });",
              "            })(i, user.username, user.token);",
              "        }",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/stats",
