          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "stats"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Get Friends Feed",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Get registered users",
              "const users = JSON.parse(pm.collectionVariables.get(\"registered_users\") || \"[]\");",
              "",
              "if (users.length === 0) {",
              "    console.log(\"❌ No registered users found. Run registration first.\");",
              "    return;",
              "}",
              "",
              "console.log(\"Getting friends feed for all users...\");",
              "",
              "// Store feeds for analysis",
              "const allFeeds = [];",
              "",
              "// For each user, get their friends feed",
              "users.forEach((user, index) => {",
              "    console.log(`Fetching feed for user ${index + 1}/${users.length}: ${user.username}`);",
              "    ",
              "    pm.sendRequest({",
              "        url: \"http://localhost:8080/post/feed\",",
              "        method: \"GET\",",
              "        header: {",
              "            \"Authorization\": `Bearer ${user.token}`",
              "        }",
              "    }, function (err, res) {",
              "        if (!err && res.status === \"OK\") {",
              "            const feed = res.json();",
              "            allFeeds.push({",
              "                username: user.username,",
              "                feed: feed",
              "            });",
              "            console.log(`  ✅ Feed retrieved for ${user.username}: ${feed.length || feed.posts?.length || 0} posts`);",
              "            ",
              "            if (allFeeds.length === users.length) {",
              "                pm.collectionVariables.set(\"all_feeds\", JSON.stringify(allFeeds));",
              "                console.log(\"✅ All feeds retrieved successfully!\");",
              "                ",
              "                // Print summary",
              "                console.log(\"\\n=== FEED SUMMARY ===\");",
              "                allFeeds.forEach(f => {",
              "                    const postCount = f.feed.length || f.feed.posts?.length || 0;",
              "                    console.log(`${f.username}: ${postCount} posts in feed`);",
              "                });",
              "            }",
              "        } else {",
              "            console.log(`  ❌ Failed to get feed for ${user.username}`);",
              "        }",
              "    });",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/stats",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "stats"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Display Statistics",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const users = JSON.parse(pm.collectionVariables.get(\"registered_users\") || \"[]\");",
              "const allFeeds = JSON.parse(pm.collectionVariables.get(\"all_feeds\") || \"[]\");",
              "const N = parseInt(pm.collectionVariables.get(\"N_users\")) || 5;",
              "",
              "console.log(\"\\n╔══════════════════════════════════╗\");",
              "console.log(\"║        TEST STATISTICS           ║\");",
              "console.log(\"╚══════════════════════════════════╝\");",
              "",
              "console.log(`📊 Total users registered: ${users.length}`);",
              "console.log(`📊 Expected users: ${N}`);",
              "",
              "console.log(\"\\n👥 Registered Users:\");",
              "users.forEach((user, i) => {",
              "    console.log(`  ${i+1}. Username: ${user.username}, ID: ${user.profile_id}`);",
              "});",
              "",
              "console.log(\"\\n🤝 Friends Network:\");",
              "users.forEach(user => {",
              "    console.log(`  ${user.username} should be friends with ${users.length - 1} other users`);",
              "});",
              "",
              "console.log(`\\n📝 Posts created: ${N} posts per user = ${N * users.length} total posts`);",
              "",
              "console.log(\"\\n📱 Feed Results:\");",
              "if (allFeeds.length > 0) {",
              "    allFeeds.forEach(f => {",
              "        const postCount = f.feed.length || f.feed.posts?.length || 0;",
              "        console.log(`  ${f.username}: ${postCount} posts`);",
              "    });",
              "    ",
              "    const expectedPostsPerFeed = (users.length - 1) * N;",
              "    console.log(`\\n💡 Expected posts per feed: ${expectedPostsPerFeed} (${users.length - 1} friends × ${N} posts)`);",
              "} else {",
              "    console.log(\"  ⚠️ Run 'Get Friends Feed' request first to see feed statistics\");",
              "}",
              "",
              "console.log(\"\\n═══════════════════════════════════\\n\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/stats",
