  "item": [
    {
      "name": "1. Register N Users",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Set number of users to register",
              "const N = 5; // Change this value as needed",
              "pm.collectionVariables.set(\"N_users\", N);",
              "",
              "// Initialize arrays to store user data",
              "const users = [];",
              "",
              "console.log(`Starting registration of ${N} users...`);",
              "",
              "const timestamp = Date.now();",
              "",
              "// Function to generate profile data",
              "function generateProfileData() {",
              "    const maleNames = [\"Иван\",\"Алексей\",\"Дмитрий\",\"Сергей\",\"Андрей\",\"Михаил\",\"Никита\",\"Артем\"];",
              "    const femaleNames = [\"Анна\",\"Мария\",\"Екатерина\",\"Ольга\",\"Наталья\",\"Ирина\",\"Дарья\",\"Алина\"];",
              "    const lastNames = [\"Иванов\",\"Петров\",\"Сидоров\",\"Смирнов\",\"Кузнецов\",\"Попов\"];",
              "    const lastNamesFemale = [\"Иванова\",\"Петрова\",\"Сидорова\",\"Смирнова\",\"Кузнецова\",\"Попова\"];",
              "    const interestsList = [\"книги\",\"футбол\",\"музыка\",\"кино\",\"путешествия\",\"технологии\",\"спорт\",\"шахматы\",\"рисование\",\"игры\"];",
              "    const cities = [\"Москва\",\"Санкт-Петербург\",\"Новосибирск\",\"Екатеринбург\",\"Казань\",\"Нижний Новгород\",\"Челябинск\",\"Самара\",\"Омск\",\"Ростов-на-Дону\",\"Уфа\",\"Красноярск\",\"Воронеж\",\"Пермь\",\"Волгоград\"];",
              "    ",
              "    function random(arr) {",
              "        return arr[Math.floor(Math.random() * arr.length)];",
              "    }",
              "    ",
              "    const gender = Math.random() < 0.5 ? \"MALE\" : \"FEMALE\";",
              "    const name = gender === \"MALE\" ? random(maleNames) : random(femaleNames);",
              "    const surname = gender === \"MALE\" ? random(lastNames) : random(lastNamesFemale);",
              "    const shuffled = interestsList.sort(() => 0.5 - Math.random());",
              "    const interests = shuffled.slice(0, Math.floor(Math.random()*3) + 2).join(\", \");",
              "    ",
              "    function randomDate(startYear, endYear) {",
              "        const start = new Date(startYear, 0, 1).getTime();",
              "        const end = new Date(endYear, 0, 1).getTime();",
              "        const randomTime = start + Math.random() * (end - start);",
              "        return new Date(randomTime).toISOString();",
              "    }",
              "    ",
              "    const dateOfBirth = randomDate(1970, 2005);",
              "    const city = random(cities);",
              "    ",
              "    return {",
              "        name: name,",
              "        surname: surname,",
              "        date_of_birth: dateOfBirth,",
              "        gender: gender,",
              "        interests: interests,",
              "        city: city",
              "    };",
              "}",
              "",
              "// Counter for completed registrations",
              "let completedCount = 0;",
              "",
              "// Register N users",
              "for (let i = 0; i < N; i++) {",
              "    console.log(\"enter \" + i + \" user registration\");",
              "    const username = pm.variables.replaceIn(\"{{$randomUserName}}\") + timestamp;",
              "    const email = pm.variables.replaceIn(\"{{$randomEmail}}\") + timestamp;",
              "    ",
              "    const requestBody = {",
              "        username: username,",
              "        email: email,",
              "        password: \"Qwerty123!\"",
              "    };",
              "",
              "    pm.sendRequest({",
              "        url: \"http://localhost:8080/auth/register\",",
              "        method: \"POST\",",
              "        header: {",
              "            \"Content-Type\": \"application/json\"",
              "        },",
              "        body: {",
              "            mode: \"raw\",",
              "            raw: JSON.stringify(requestBody)",
              "        }",
              "    }, function (err, res) {",
              "        // Check HTTP status code (200-299)",
              "        if (!err && res.code >= 200 && res.code < 300) {",
              "            const response = res.json();",
              "            console.log(`User ${i+1} registered: ${username}`);",
              "            ",
              "            // Login to get token and user ID",
              "            const loginBody = {",
              "                username: username,",
              "                password: \"Qwerty123!\"",
              "            };",
              "            ",
              "            pm.sendRequest({",
              "                url: \"http://localhost:8080/auth/login\",",
              "                method: \"POST\",",
              "                header: {",
              "                    \"Content-Type\": \"application/json\"",
              "                },",
              "                body: {",
              "                    mode: \"raw\",",
              "                    raw: JSON.stringify(loginBody)",
              "                }",
              "            }, function (err2, res2) {",
              "                if (!err2 && res2.code >= 200 && res2.code < 300) {",
              "                    const loginResponse = res2.json();",
              "                    const token = loginResponse.access_token;",
              "                    const profileId = loginResponse.profile_id || response.id;",
              "                    ",
              "                    // Create profile",
              "                    const profileData = generateProfileData();",
              "                    ",
              "                    pm.sendRequest({",
              "                        url: \"http://localhost:8080/profile\",",
              "                        method: \"POST\",",
              "                        header: {",
              "                            \"Content-Type\": \"application/json\",",
              "                            \"Authorization\": \"Bearer \" + token",
              "                        },",
              "                        body: {",
              "                            mode: \"raw\",",
              "                            raw: JSON.stringify(profileData)",
              "                        }",
              "                    }, function (err3, res3) {",
              "                        completedCount++;",
              "                        ",
              "                        if (!err3 && res3.code >= 200 && res3.code < 300) {",
              "                            const profileResponse = res3.json();",
              "                            const finalProfileId = profileResponse.user_id;",
              "                            ",
              "                            users.push({",
              "                                username: username,",
              "                                email: email,",
              "                                password: \"Qwerty123!\",",
              "                                token: token,",
              "                                profile_id: finalProfileId",
              "                            });",
              "                            ",
              "                            console.log(`✅ Profile created for ${username}, ID: ${finalProfileId}`);",
              "                        } else {",
              "                            // If profile creation fails, still save user with login data",
              "                            users.push({",
              "                                username: username,",
              "                                email: email,",
              "                                password: \"Qwerty123!\",",
              "                                token: token,",
              "                                profile_id: profileId",
              "                            });",
              "                            ",
              "                            console.log(`⚠️ Profile creation failed for ${username}, using login ID: ${profileId}`);",
              "                        }",
              "                        ",
              "                        // Check if all users are processed",
              "                        if (completedCount === N) {",
              "                            pm.collectionVariables.set(\"registered_users\", JSON.stringify(users));",
              "                            console.log(`✅ All ${N} users registered successfully!`);",
              "                            console.log(\"Registered users:\", users.map(u => ({username: u.username, id: u.profile_id})));",
              "                        }",
              "                    });",
              "                } else {",
              "                    completedCount++;",
              "                    console.log(`❌ Login failed for ${username}, status: ${res2 ? res2.code : 'no response'}`);",
              "                    ",
              "                    if (completedCount === N) {",
              "                        pm.collectionVariables.set(\"registered_users\", JSON.stringify(users));",
              "                        console.log(`⚠️ Registration completed with ${users.length} successful users out of ${N}`);",
              "                    }",
              "                }",
              "            });",
              "        } else {",
              "            completedCount++;",
              "            console.log(`❌ Registration failed for user ${i}, status: ${res ? res.code : 'no response'}, error: ${err}`);",
              "            ",
              "            if (completedCount === N) {",
              "                pm.collectionVariables.set(\"registered_users\", JSON.stringify(users));",
              "                console.log(`⚠️ Registration completed with ${users.length} successful users out of ${N}`);",
              "            }",
              "        }",
              "    });",
              "}",
              "",
              "// Keep the script running to wait for async requests",
              "// This is needed for Postman pre-request scripts"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
