    {
      "name": "http://localhost:8080/profile",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "/******************************************************************",
              " * CONFIG",
              " ******************************************************************/",
              "",
              "const URLS = {",
              "  maleNames:",
              "    \"https://raw.githubusercontent.com/Raven-SL/ru-pnames-list/refs/heads/master/lists/male_names_rus.txt\",",
              "",
              "  femaleNames:",
              "    \"https://raw.githubusercontent.com/Raven-SL/ru-pnames-list/refs/heads/master/lists/female_names_rus.txt\",",
              "",
              "  maleLastNames:",
              "    \"https://raw.githubusercontent.com/Raven-SL/ru-pnames-list/refs/heads/master/lists/male_surnames_rus.txt\"",
              "};",
              "",
              "",
              "/******************************************************************",
              " * HELPERS",
              " ******************************************************************/",
              "",
              "function random(arr) {",
              "  return arr[Math.floor(Math.random() * arr.length)];",
              "}",
              "",
              "// ---- HTTP loader → Promise ----",
              "function fetchTxt(url) {",
              "  return new Promise((resolve, reject) => {",
              "",
              "    pm.sendRequest(url, (err, res) => {",
              "      if (err) return reject(err);",
              "",
              "      const arr = res.text()",
              "        .split(\"\\n\")",
              "        .map(v => v.trim())",
              "        .filter(Boolean);",
              "",
              "      resolve(arr);",
              "    });",
              "",
              "  });",
              "}",
              "",
              "",
              "// ---- cache loader ----",
              "async function loadList(cacheKey, url) {",
              "",
              "  const cached = pm.collectionVariables.get(cacheKey);",
              "",
              "  if (cached) {",
              "    return JSON.parse(cached);",
              "  }",
              "",
              "  console.log(\"Loading:\", cacheKey);",
              "",
              "  const data = await fetchTxt(url);",
              "",
              "  pm.collectionVariables.set(",
              "    cacheKey,",
              "    JSON.stringify(data)",
              "  );",
              "",
              "  return data;",
              "}",
              "",
              "",
              "/******************************************************************",
              " * RUSSIAN SURNAME FEMINIZATION",
              " ******************************************************************/",
              "",
              "/*",
              "  Простая но практичная морфология:",
              "",
              "  ✔ Иванов → Иванова",
              "  ✔ Петров → Петрова",
              "  ✔ Сидорин → Сидорина",
              "  ✔ Кузнецов → Кузнецова",
              "",
              "  НЕ меняются:",
              "  ✔ Черных",
              "  ✔ Долгих",
              "  ✔ Живаго",
              "  ✔ Шевченко",
              "  ✔ Саакян",
              "  ✔ Ким",
              "*/",
              "",
              "function feminizeSurname(surname) {",
              "",
              "  const lower = surname.toLowerCase();",
              "",
              "  // неизменяемые окончания",
              "  const immutableEndings = [",
              "    \"ко\", \"енко\", \"ян\", \"янц\", \"дзе\",",
              "    \"швили\", \"оглы\", \"кызы\",",
              "    \"их\", \"ых\",",
              "    \"о\", \"е\", \"у\", \"ю\",",
              "    \"иа\"",
              "  ];",
              "",
              "  if (immutableEndings.some(e => lower.endsWith(e))) {",
              "    return surname;",
              "  }",
              "",
              "  // уже женская",
              "  if (lower.endsWith(\"а\")) {",
              "    return surname;",
              "  }",
              "",
              "  // классические русские фамилии",
              "  if (",
              "    lower.endsWith(\"ов\") ||",
              "    lower.endsWith(\"ев\") ||",
              "    lower.endsWith(\"ин\") ||",
              "    lower.endsWith(\"ын\")",
              "  ) {",
              "    return surname + \"а\";",
              "  }",
              "",
              "  // fallback (редкие случаи — не меняем)",
              "  return surname;",
              "}",
              "",
              "",
              "/******************************************************************",
              " * RANDOM DATA GENERATION",
              " ******************************************************************/",
              "",
              "function randomDate(startYear, endYear) {",
              "  const start = new Date(startYear, 0, 1).getTime();",
              "  const end = new Date(endYear, 0, 1).getTime();",
              "  const t = start + Math.random() * (end - start);",
              "  return new Date(t).toISOString();",
              "}",
              "",
              "const interestsList = [",
              "  \"книги\",\"футбол\",\"музыка\",\"кино\",\"путешествия\",",
              "  \"технологии\",\"спорт\",\"шахматы\",\"рисование\",\"игры\"",
              "];",
              "",
              "const cities = [",
              "  \"Москва\",\"Санкт-Петербург\",\"Новосибирск\",\"Екатеринбург\",",
              "  \"Казань\",\"Нижний Новгород\",\"Челябинск\",\"Самара\",",
              "  \"Омск\",\"Ростов-на-Дону\",\"Уфа\",\"Красноярск\",",
              "  \"Воронеж\",\"Пермь\",\"Волгоград\"",
              "];",
              "",
              "",
              "/******************************************************************",
              " * MAIN (ASYNC — CLEAN VERSION)",
              " ******************************************************************/",
              "",
              "(async () => {",
              "",
              "  try {",
              "",
              "    const [",
              "      maleNames,",
              "      femaleNames,",
              "      maleLastNames",
              "    ] = await Promise.all([",
              "      loadList(\"maleNamesArr\", URLS.maleNames),",
              "      loadList(\"femaleNamesArr\", URLS.femaleNames),",
              "      loadList(\"maleLastNamesArr\", URLS.maleLastNames)",
              "    ]);",
              "",
              "    const gender = Math.random() < 0.5 ? \"MALE\" : \"FEMALE\";",
              "",
              "    const name =",
              "      gender === \"MALE\"",
              "        ? random(maleNames)",
              "        : random(femaleNames);",
              "",
              "    let surname = random(maleLastNames);",
              "",
              "    if (gender === \"FEMALE\") {",
              "      surname = feminizeSurname(surname);",
              "    }",
              "",
              "    const shuffled = [...interestsList]",
              "      .sort(() => 0.5 - Math.random());",
              "",
              "    const interests = shuffled",
              "      .slice(0, Math.floor(Math.random()*3) + 2)",
              "      .join(\", \");",
              "",
              "    const dateOfBirth = randomDate(1970, 2005);",
              "    const city = random(cities);",
              "",
              "    /******** SAVE ********/",
              "",
              "    pm.collectionVariables.set(\"name\", name);",
              "    pm.collectionVariables.set(\"surname\", surname);",
              "    pm.collectionVariables.set(\"gender\", gender);",
              "    pm.collectionVariables.set(\"interests\", interests);",
              "    pm.collectionVariables.set(\"date_of_birth\", dateOfBirth);",
              "    pm.collectionVariables.set(\"city\", city);",
              "",
              "    console.log(\"Generated:\", name, surname, gender);",
              "",
              "  } catch (e) {",
              "    console.error(\"Generator error:\", e);",
              "  }",
              "",
              "})();"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
