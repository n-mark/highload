    {
      "name": "http://localhost:8080/profile",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const maleNames = [\"Иван\",\"Алексей\",\"Дмитрий\",\"Сергей\",\"Андрей\",\"Михаил\",\"Никита\",\"Артем\"];",
              "const femaleNames = [\"Анна\",\"Мария\",\"Екатерина\",\"Ольга\",\"Наталья\",\"Ирина\",\"Дарья\",\"Алина\"];",
              "",
              "const lastNames = [\"Иванов\",\"Петров\",\"Сидоров\",\"Смирнов\",\"Кузнецов\",\"Попов\"];",
              "const lastNamesFemale = [\"Иванова\",\"Петрова\",\"Сидорова\",\"Смирнова\",\"Кузнецова\",\"Попова\"];",
              "",
              "const interestsList = [",
              "\"книги\",\"футбол\",\"музыка\",\"кино\",\"путешествия\",",
              "\"технологии\",\"спорт\",\"шахматы\",\"рисование\",\"игры\"",
              "];",
              "",
              "",
              "const cities = [",
              "\"Москва\",",
              "\"Санкт-Петербург\",",
              "\"Новосибирск\",",
              "\"Екатеринбург\",",
              "\"Казань\",",
              "\"Нижний Новгород\",",
              "\"Челябинск\",",
              "\"Самара\",",
              "\"Омск\",",
              "\"Ростов-на-Дону\",",
              "\"Уфа\",",
              "\"Красноярск\",",
              "\"Воронеж\",",
              "\"Пермь\",",
              "\"Волгоград\"",
              "];",
              "",
              "function random(arr) {",
              "  return arr[Math.floor(Math.random() * arr.length)];",
              "}",
              "",
              "const gender = Math.random() < 0.5 ? \"MALE\" : \"FEMALE\";",
              "",
              "const name = gender === \"MALE\"",
              "  ? random(maleNames)",
              "  : random(femaleNames);",
              "",
              "const surname = gender === \"MALE\"",
              "  ? random(lastNames)",
              "  : random(lastNamesFemale);",
              "",
              "const shuffled = interestsList.sort(() => 0.5 - Math.random());",
              "const interests = shuffled.slice(0, Math.floor(Math.random()*3) + 2).join(\", \");",
              "",
              "function randomDate(startYear, endYear) {",
              "  const start = new Date(startYear, 0, 1).getTime();",
              "  const end = new Date(endYear, 0, 1).getTime();",
              "  const randomTime = start + Math.random() * (end - start);",
              "  return new Date(randomTime).toISOString();",
              "}",
              "",
              "const dateOfBirth = randomDate(1970, 2005);",
              "const city = random(cities);",
              "",
              "pm.collectionVariables.set(\"name\", name);",
              "pm.collectionVariables.set(\"surname\", surname);",
              "pm.collectionVariables.set(\"gender\", gender);",
              "pm.collectionVariables.set(\"interests\", interests);",
              "pm.collectionVariables.set(\"date_of_birth\", dateOfBirth);",
              "pm.collectionVariables.set(\"city\", city);",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
