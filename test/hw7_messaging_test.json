{
  "info": {
    "_postman_id": "messaging-test-001",
    "name": "Messaging Test",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "24633807"
  },
  "item": [
    {
      "name": "1. Register N Users",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Set number of users to register",
              "const N = 5;",
              "pm.collectionVariables.set(\"N_users\", N);",
              "",
              "const users = [];",
              "console.log(`Starting registration of ${N} users...`);",
              "",
              "const timestamp = Date.now();",
              "",
              "function generateProfileData() {",
              "    const maleNames = [\"Иван\",\"Алексей\",\"Дмитрий\",\"Сергей\",\"Андрей\",\"Михаил\",\"Никита\",\"Артем\"];",
              "    const femaleNames = [\"Анна\",\"Мария\",\"Екатерина\",\"Ольга\",\"Наталья\",\"Ирина\",\"Дарья\",\"Алина\"];",
              "    const lastNames = [\"Иванов\",\"Петров\",\"Сидоров\",\"Смирнов\",\"Кузнецов\",\"Попов\"];",
              "    const lastNamesFemale = [\"Иванова\",\"Петрова\",\"Сидорова\",\"Смирнова\",\"Кузнецова\",\"Попова\"];",
              "    const interestsList = [\"книги\",\"футбол\",\"музыка\",\"кино\",\"путешествия\",\"технологии\",\"спорт\",\"шахматы\",\"рисование\",\"игры\"];",
              "    const cities = [\"Москва\",\"Санкт-Петербург\",\"Новосибирск\",\"Екатеринбург\",\"Казань\",\"Нижний Новгород\",\"Челябинск\",\"Самара\",\"Омск\",\"Ростов-на-Дону\",\"Уфа\",\"Красноярск\",\"Воронеж\",\"Пермь\",\"Волгоград\"];",
              "    ",
              "    function random(arr) { return arr[Math.floor(Math.random() * arr.length)]; }",
              "    ",
              "    const gender = Math.random() < 0.5 ? \"MALE\" : \"FEMALE\";",
              "    const name = gender === \"MALE\" ? random(maleNames) : random(femaleNames);",
              "    const surname = gender === \"MALE\" ? random(lastNames) : random(lastNamesFemale);",
              "    const shuffled = interestsList.sort(() => 0.5 - Math.random());",
              "    const interests = shuffled.slice(0, Math.floor(Math.random()*3) + 2).join(\", \");",
              "    ",
              "    function randomDate(startYear, endYear) {",
              "        const start = new Date(startYear, 0, 1).getTime();",
              "        const end = new Date(endYear, 0, 1).getTime();",
              "        const randomTime = start + Math.random() * (end - start);",
              "        return new Date(randomTime).toISOString();",
              "    }",
              "    ",
              "    return {",
              "        name: name,",
              "        surname: surname,",
              "        date_of_birth: randomDate(1970, 2005),",
              "        gender: gender,",
              "        interests: interests,",
              "        city: random(cities)",
              "    };",
              "}",
              "",
              "let completedCount = 0;",
              "",
              "for (let i = 0; i < N; i++) {",
              "    console.log(\"Registering user \" + (i+1) + \"/\" + N);",
              "    const username = pm.variables.replaceIn(\"{{$randomUserName}}\") + timestamp;",
              "    const email = pm.variables.replaceIn(\"{{$randomEmail}}\") + timestamp;",
              "    ",
              "    pm.sendRequest({",
              "        url: \"http://localhost:8080/auth/register\",",
              "        method: \"POST\",",
              "        header: { \"Content-Type\": \"application/json\" },",
              "        body: { mode: \"raw\", raw: JSON.stringify({ username, email, password: \"Qwerty123!\" }) }",
              "    }, function (err, res) {",
              "        if (!err && res.code >= 200 && res.code < 300) {",
              "            const response = res.json();",
              "            ",
              "            pm.sendRequest({",
              "                url: \"http://localhost:8080/auth/login\",",
              "                method: \"POST\",",
              "                header: { \"Content-Type\": \"application/json\" },",
              "                body: { mode: \"raw\", raw: JSON.stringify({ username, password: \"Qwerty123!\" }) }",
              "            }, function (err2, res2) {",
              "                if (!err2 && res2.code >= 200 && res2.code < 300) {",
              "                    const loginResponse = res2.json();",
              "                    const token = loginResponse.access_token;",
              "                    const profileId = loginResponse.profile_id || response.id;",
              "                    ",
              "                    pm.sendRequest({",
              "                        url: \"http://localhost:8080/profile\",",
              "                        method: \"POST\",",
              "                        header: {",
              "                            \"Content-Type\": \"application/json\",",
              "                            \"Authorization\": \"Bearer \" + token",
              "                        },",
              "                        body: { mode: \"raw\", raw: JSON.stringify(generateProfileData()) }",
              "                    }, function (err3, res3) {",
              "                        completedCount++;",
              "                        ",
              "                        const finalProfileId = (!err3 && res3.code >= 200 && res3.code < 300)",
              "                            ? (res3.json().user_id || profileId)",
              "                            : profileId;",
              "                        ",
              "                        users.push({",
              "                            username, email, password: \"Qwerty123!\",",
              "                            token, profile_id: finalProfileId",
              "                        });",
              "                        ",
              "                        console.log(`✅ User ${completedCount} registered: ${username} (ID: ${finalProfileId})`);",
              "                        ",
              "                        if (completedCount === N) {",
              "                            pm.collectionVariables.set(\"registered_users\", JSON.stringify(users));",
              "                            console.log(`✅ All ${N} users registered!`);",
              "                        }",
              "                    });",
              "                } else {",
              "                    completedCount++;",
              "                    if (completedCount === N) pm.collectionVariables.set(\"registered_users\", JSON.stringify(users));",
              "                }",
              "            });",
              "        } else {",
              "            completedCount++;",
              "            if (completedCount === N) pm.collectionVariables.set(\"registered_users\", JSON.stringify(users));",
              "        }",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "protocolProfileBehavior": { "disableBodyPruning": true },
      "request": {
        "method": "GET",
        "header": [],
        "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "http://localhost:8080/stats", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["stats"] }
      },
      "response": []
    },
    {
      "name": "2. Register New User, Search and Send Messages",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const existingUsers = JSON.parse(pm.collectionVariables.get(\"registered_users\") || \"[]\");",
              "",
              "if (existingUsers.length === 0) {",
              "    console.log(\"❌ No existing users. Run step 1 first.\");",
              "    return;",
              "}",
              "",
              "console.log(\"=== REGISTERING NEW USER ===\");",
              "",
              "const timestamp = Date.now();",
              "const newUsername = pm.variables.replaceIn(\"{{$randomUserName}}\") + timestamp;",
              "const newEmail = pm.variables.replaceIn(\"{{$randomEmail}}\") + timestamp;",
              "",
              "// Step 1: Register new user",
              "pm.sendRequest({",
              "    url: \"http://localhost:8080/auth/register\",",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\" },",
              "    body: { mode: \"raw\", raw: JSON.stringify({ username: newUsername, email: newEmail, password: \"Qwerty123!\" }) }",
              "}, function (err, res) {",
              "    if (err || res.code < 200 || res.code >= 300) {",
              "        console.log(\"❌ Registration failed\");",
              "        return;",
              "    }",
              "    console.log(`✅ New user registered: ${newUsername}`);",
              "    ",
              "    // Step 2: Login",
              "    pm.sendRequest({",
              "        url: \"http://localhost:8080/auth/login\",",
              "        method: \"POST\",",
              "        header: { \"Content-Type\": \"application/json\" },",
              "        body: { mode: \"raw\", raw: JSON.stringify({ username: newUsername, password: \"Qwerty123!\" }) }",
              "    }, function(err2, res2) {",
              "        if (err2 || res2.code < 200 || res2.code >= 300) {",
              "            console.log(\"❌ Login failed\");",
              "            return;",
              "        }",
              "        ",
              "        const loginResponse = res2.json();",
              "        const newUserToken = loginResponse.access_token;",
              "        console.log(`✅ Logged in, token received`);",
              "        ",
              "        // Step 3: Search users via /profile/list (like JMeter test)",
              "        // Generate random search query like JMeter: consonant+vowel+space+consonant+vowel",
              "        const consonants = \"бвгджзклмнпрстфхцчш\";",
              "        const vowels = \"аеиоуэя\";",
              "        const randomConsonant1 = consonants[Math.floor(Math.random() * consonants.length)];",
              "        const randomVowel1 = vowels[Math.floor(Math.random() * vowels.length)];",
              "        const randomConsonant2 = consonants[Math.floor(Math.random() * consonants.length)];",
              "        const randomVowel2 = vowels[Math.floor(Math.random() * vowels.length)];",
              "        const searchQuery = randomConsonant1 + randomVowel1 + \" \" + randomConsonant2 + randomVowel2;",
              "        ",
              "        console.log(`\\n🔍 Searching users with query: \"${searchQuery}\"`);",
              "        ",
              "        pm.sendRequest({",
              "            url: \"http://localhost:8080/profile/list\",",
              "            method: \"POST\",",
              "            header: {",
              "                \"Content-Type\": \"application/json\",",
              "                \"Authorization\": \"Bearer \" + newUserToken",
              "            },",
              "            body: { mode: \"raw\", raw: JSON.stringify({ query: searchQuery }) }",
              "        }, function(err3, res3) {",
              "            if (err3 || res3.code < 200 || res3.code >= 300) {",
              "                console.log(\"❌ Profile list search failed\");",
              "                return;",
              "            }",
              "            ",
              "            const searchResults = res3.json();",
              "            const foundUsers = Array.isArray(searchResults) ? searchResults : (searchResults.profiles || searchResults.users || []);",
              "            console.log(`Found ${foundUsers.length} users in search`);",
              "            ",
              "            // Get profile IDs from search results",
              "            const targetIds = foundUsers",
              "                .map(u => u.profile_id || u.user_id || u.id)",
              "                .filter(id => id)",
              "                .slice(0, Math.min(3, foundUsers.length));",
              "            ",
              "            // Also get profiles via individual requests (like JMeter does)",
              "            console.log(\"\\n📋 Fetching individual profiles...\");",
              "            let profilesFetched = 0;",
              "            const targetUsers = [];",
              "            ",
              "            if (targetIds.length === 0) {",
              "                // Fallback: use existing users",
              "                console.log(\"No users found in search, using existing users as fallback\");",
              "                const fallbackTargets = existingUsers.slice(0, Math.min(3, existingUsers.length));",
              "                startMessaging(newUserToken, newUsername, fallbackTargets);",
              "                return;",
              "            }",
              "            ",
              "            targetIds.forEach((profileId) => {",
              "                pm.sendRequest({",
              "                    url: \"http://localhost:8080/profile?profile_id=\" + profileId,",
              "                    method: \"GET\",",
              "                    header: {",
              "                        \"Content-Type\": \"application/json\",",
              "                        \"Authorization\": \"Bearer \" + newUserToken",
              "                    }",
              "                }, function(err4, res4) {",
              "                    profilesFetched++;",
              "                    ",
              "                    if (!err4 && res4.code >= 200 && res4.code < 300) {",
              "                        const profile = res4.json();",
              "                        targetUsers.push({",
              "                            profile_id: profileId,",
              "                            username: profile.username || profile.name || \"user_\" + profileId",
              "                        });",
              "                        console.log(`  ✅ Fetched profile: ${targetUsers[targetUsers.length-1].username} (ID: ${profileId})`);",
              "                    } else {",
              "                        console.log(`  ❌ Failed to fetch profile ID: ${profileId}`);",
              "                    }",
              "                    ",
              "                    if (profilesFetched === targetIds.length) {",
              "                        if (targetUsers.length === 0) {",
              "                            const fallbackTargets = existingUsers.slice(0, Math.min(3, existingUsers.length));",
              "                            startMessaging(newUserToken, newUsername, fallbackTargets);",
              "                        } else {",
              "                            startMessaging(newUserToken, newUsername, targetUsers);",
              "                        }",
              "                    }",
              "                });",
              "            });",
              "            ",
              "            function startMessaging(token, username, targets) {",
              "                console.log(`\\n💬 Sending messages to ${targets.length} users...`);",
              "                let messagesSent = 0;",
              "                const messageResults = [];",
              "                ",
              "                targets.forEach((targetUser) => {",
              "                    const messageText = `Hello! This is a test message from ${username} sent at ${new Date().toISOString()}`;",
              "                    ",
              "                    pm.sendRequest({",
              "                        url: \"http://localhost:8080/dialog/\" + targetUser.profile_id + \"/send\",",
              "                        method: \"POST\",",
              "                        header: {",
              "                            \"Content-Type\": \"application/json\",",
              "                            \"Authorization\": \"Bearer \" + token",
              "                        },",
              "                        body: { mode: \"raw\", raw: JSON.stringify({ text: messageText }) }",
              "                    }, function(err5, res5) {",
              "                        messagesSent++;",
              "                        ",
              "                        if (!err5 && res5.code >= 200 && res5.code < 300) {",
              "                            console.log(`  ✅ Message sent to ${targetUser.username} (ID: ${targetUser.profile_id})`);",
              "                            messageResults.push({ target: targetUser.username, target_id: targetUser.profile_id, success: true });",
              "                        } else {",
              "                            console.log(`  ❌ Failed to send message to ${targetUser.username}`);",
              "                            messageResults.push({ target: targetUser.username, target_id: targetUser.profile_id, success: false });",
              "                        }",
              "                        ",
              "                        if (messagesSent === targets.length) {",
              "                            // Step 4: Verify dialogs",
              "                            console.log(\"\\n📋 Verifying dialogs...\");",
              "                            let dialogsChecked = 0;",
              "                            ",
              "                            targets.forEach((targetUser) => {",
              "                                pm.sendRequest({",
              "                                    url: \"http://localhost:8080/dialog/\" + targetUser.profile_id + \"/list\",",
              "                                    method: \"GET\",",
              "                                    header: { \"Authorization\": \"Bearer \" + token }",
              "                                }, function(err6, res6) {",
              "                                    dialogsChecked++;",
              "                                    let msgCount = 0;",
              "                                    ",
              "                                    if (!err6 && res6.code >= 200 && res6.code < 300) {",
              "                                        const dialogData = res6.json();",
              "                                        const messages = dialogData.messages || dialogData || [];",
              "                                        msgCount = Array.isArray(messages) ? messages.length : 0;",
              "                                        console.log(`  ✅ Dialog with ${targetUser.username}: ${msgCount} messages`);",
              "                                    } else {",
              "                                        console.log(`  ❌ Failed to get dialog with ${targetUser.username}`);",
              "                                    }",
              "                                    ",
              "                                    if (dialogsChecked === targets.length) {",
              "                                        console.log(\"\\n=== MESSAGING TEST SUMMARY ===\");",
              "                                        console.log(`New user: ${username}`);",
              "                                        console.log(`Messages sent: ${messageResults.filter(r => r.success).length}/${targets.length}`);",
              "                                        console.log(\"====================================\\n\");",
              "                                    }",
              "                                });",
              "                            });",
              "                        }",
              "                    });",
              "                });",
              "            }",
              "        });",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "protocolProfileBehavior": { "disableBodyPruning": true },
      "request": {
        "method": "GET",
        "header": [],
        "body": { "mode": "raw", "raw": "", "options": { "raw": { "language": "json" } } },
        "url": { "raw": "http://localhost:8080/stats", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["stats"] }
      },
      "response": []
    }
  ],
  "auth": { "type": "bearer" },
  "variable": [
    { "key": "N_users", "value": "5" },
    { "key": "registered_users", "value": "[]" },
    { "key": "access_token", "value": "" },
    { "key": "profile_id", "value": "" },
    { "key": "username", "value": "" },
    { "key": "email", "value": "" }
  ]
}