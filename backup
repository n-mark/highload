services:
  postgres-master:
    image: postgres:18.3
    container_name: hl_postgres_master
    restart: unless-stopped
    environment:
      POSTGRES_DB: social
      POSTGRES_USER: social_user
      POSTGRES_PASSWORD: social_pass
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql
      - ./db/init:/docker-entrypoint-initdb.d
      - ./db/master/postgresql.conf:/etc/postgresql/postgresql.conf
      - ./db/master/pg_hba.conf:/etc/postgresql/pg_hba.conf
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U social_user -d social"]
      interval: 5s
      timeout: 5s
      retries: 10
    command: >
      postgres
      -c config_file=/etc/postgresql/postgresql.conf
      -c hba_file=/etc/postgresql/pg_hba.conf
    networks:
      - pgcluster

  postgres-slave1:
    image: postgres:18.3
    container_name: hl_postgres_slave1
    restart: unless-stopped
    environment:
      PGPASSWORD: replicator_pass
    ports:
      - "5433:5432"
    volumes:
      - pgdata_slave1:/var/lib/postgresql/data
      - ./db/slave/postgresql.conf:/etc/postgresql/postgresql.conf
    depends_on:
      postgres-master:
        condition: service_healthy
    entrypoint: /bin/bash
    command: >
      -c "
        set -e
        if [ ! -s /var/lib/postgresql/data/PG_VERSION ]; then
          echo 'Waiting for master to accept replication connections...'
          until pg_isready -h postgres-master -p 5432 -U replicator -d social; do
            sleep 2
          done
          sleep 3
          echo 'Creating base backup from master...'
          chown -R postgres:postgres /var/lib/postgresql/data
          gosu postgres pg_basebackup -h postgres-master -U replicator -D /var/lib/postgresql/data -Fp -Xs -P -R -S slave1_slot
          chmod 700 /var/lib/postgresql/data
        fi
        exec gosu postgres postgres -D /var/lib/postgresql/data -c config_file=/etc/postgresql/postgresql.conf
      "
    networks:
      - pgcluster

  postgres-slave2:
    image: postgres:18.3
    container_name: hl_postgres_slave2
    restart: unless-stopped
    environment:
      PGPASSWORD: replicator_pass
    ports:
      - "5434:5432"
    volumes:
      - pgdata_slave2:/var/lib/postgresql/data
      - ./db/slave/postgresql.conf:/etc/postgresql/postgresql.conf
    depends_on:
      postgres-master:
        condition: service_healthy
    entrypoint: /bin/bash
    command: >
      -c "
        set -e
        if [ ! -s /var/lib/postgresql/data/PG_VERSION ]; then
          echo 'Waiting for master to accept replication connections...'
          until pg_isready -h postgres-master -p 5432 -U replicator -d social; do
            sleep 2
          done
          sleep 3
          echo 'Creating base backup from master...'
          chown -R postgres:postgres /var/lib/postgresql/data
          gosu postgres pg_basebackup -h postgres-master -U replicator -D /var/lib/postgresql/data -Fp -Xs -P -R -S slave2_slot
          chmod 700 /var/lib/postgresql/data
        fi
        exec gosu postgres postgres -D /var/lib/postgresql/data -c config_file=/etc/postgresql/postgresql.conf
      "
    networks:
      - pgcluster

  app:
    build: .
    container_name: hl_app
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      DB_HOST: postgres-master
      DB_PORT: 5432
      DB_NAME: social
      DB_USER: social_user
      DB_PASSWORD: social_pass
      JWT_SECRET: change-me-secret
      SERVER_ADDR: :8080
    depends_on:
      postgres-master:
        condition: service_healthy
    networks:
      - pgcluster

volumes:
  pgdata:
    name: highload-homework3_pgdata
  pgdata_slave1:
    name: highload-homework3_pgdata_slave1
  pgdata_slave2:
    name: highload-homework3_pgdata_slave2

networks:
  pgcluster:
    driver: bridge